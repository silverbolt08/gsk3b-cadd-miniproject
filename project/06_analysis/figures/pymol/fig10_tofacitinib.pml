# PyMOL script - Tofacitinib in the GSK-3beta ATP site
# generated by scripts/15_pymol_figures.py; interactions from PLIP
reinitialize
bg_color white
set ray_opaque_background, 1
set antialias, 2
set ray_shadows, 0
set ray_trace_mode, 0
set specular, 0.15
set ambient, 0.28
set direct, 0.55
set cartoon_transparency, 0.55
set cartoon_fancy_helices, 1
set stick_radius, 0.11
set label_size, 16
set label_color, black
set label_font_id, 7
set label_outline_color, white
set dash_gap, 0.30
set dash_width, 2.2
set dash_round_ends, 0
set transparency_mode, 2

load C:/CADD/project/06_analysis/complexes/LIG068_model_complex.pdb, cx
hide everything
show cartoon, cx and polymer
color grey80, cx and polymer

select contacts, cx and polymer and resi 28+51+100+101+154+166
show sticks, contacts and not (name C+N+O and not resn PRO)
color grey55, contacts and elem C
select lig, cx and resn LIG
show sticks, lig
set stick_radius, 0.19, lig
color cyan, lig and elem C
select nearwat, cx and resn HOH within 5 of lig
show spheres, nearwat and elem O
set sphere_scale, 0.22, nearwat
color deepteal, nearwat
util.cnc('lig or contacts')
hide everything, (hydro and (elem H and neighbor elem C))
